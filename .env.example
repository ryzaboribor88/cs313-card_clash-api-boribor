# Copy this file to ".env" and fill in your own values.
# ".env" is listed in .gitignore and must never be committed.

NODE_ENV=development
# 3001 on your own computer. The library assigns your final port at deployment.
PORT=3001

DB_HOST=127.0.0.1
DB_PORT=5432
# DB_NAME is your game slug with underscores, for example shelf_climb
DB_NAME=your_game_slug
DB_USER=postgres
# The password you chose when you installed PostgreSQL.
# In GitHub Codespaces the password is: postgres
DB_PASSWORD=your_postgres_password_here

# The key the Library Game Hub sends in the X-Hub-Key header to read your results.
# Any value works on your own computer. The library gives the real key at deployment.
HUB_API_KEY=dev-hub-key
